# ローカル開発用。コピーして .env を作る（.env はコミットしない）
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
ERROR_LOG_CHANNEL_ID=
# 指定するとこのギルドにだけコマンドを登録する（開発時は指定を推奨）
DEV_GUILD_ID=
# 管理用のコマンド（/ping など）を登録し、実行を許すギルド。DEV_GUILD_ID を指定した場合はそちらが使われる
ADMIN_GUILD_ID=
DATABASE_PATH=./data/bot.db
# fatal | error | warn | info | debug | trace（既定: info）
LOG_LEVEL=debug
