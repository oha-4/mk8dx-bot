# Dockhand のスタック mk8dx-bot の .env に設定する値（この見本に実際の値は書かない）

# beta 用の Discord アプリケーション（Message Content Intent を有効化しておく）
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
ERROR_LOG_CHANNEL_ID=
# 指定するとそのギルドにだけコマンドを登録する。未指定ならグローバル
DEV_GUILD_ID=
# 管理用のコマンド（/ping など）を登録し、実行を許すギルド
ADMIN_GUILD_ID=
LOG_LEVEL=info

# Litestream -> OCI Object Storage（S3 互換 API）
LITESTREAM_REPLICA_URL=s3://<bucket>/mk8dx-bot
LITESTREAM_S3_ENDPOINT=https://<namespace>.compat.objectstorage.ap-osaka-1.oraclecloud.com
LITESTREAM_S3_REGION=ap-osaka-1
# このバケットのオブジェクト操作だけを許された専用 IAM ユーザーの Customer Secret Key
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
