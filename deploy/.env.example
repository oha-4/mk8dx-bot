# Dockhand のスタック mk8dx-bot の .env に設定する値（この見本に実際の値は書かない）

# beta 用の Discord アプリケーション（Message Content Intent を有効化しておく）
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
ERROR_LOG_CHANNEL_ID=
# 指定するとそのギルドにだけコマンドを登録する。未指定ならグローバル
DEV_GUILD_ID=
LOG_LEVEL=info

# Litestream -> Cloudflare R2
LITESTREAM_REPLICA_URL=s3://<bucket>/mk8dx-bot
LITESTREAM_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
LITESTREAM_S3_REGION=auto
# R2 のバケット専用 API トークン（Object Read & Write）
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
