{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "tabWidth": 4,
  "printWidth": 120,
  "singleQuote": true,
  "semi": false,
  "ignorePatterns": [".claude/", "openspec/", "drizzle/meta/", "pnpm-lock.yaml"],
  "overrides": [
    {
      "files": ["**/*.yaml", "**/*.yml", "**/*.json"],
      "options": {
        "tabWidth": 2
      }
    }
  ]
}
